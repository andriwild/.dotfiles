{

    "window.menuBarVisibility": "compact",
    "editor.minimap.enabled": false,
    "zig.initialSetupDone": true,
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },
    "zig.path": "/opt/zig/zig",
    "zig.zls.path": "/home/andri/.config/Code/User/globalStorage/ziglang.vscode-zig/zls_install/zls",
    "zig.formattingProvider": "off",
    "zig.zls.enableInlayHints": false,

    "editor.lineNumbers": "relative",
    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.vimrc.enable": true,
    "vim.vimrc.path": "/home/andri/.config/vimrc",
    "vim.normalModeKeyBindingsNonRecursive": [
    {
        "before": ["<leader>", "t"],
        "commands": ["workbench.action.terminal.toggleTerminal"]
    },
    {
        "before": ["<leader>", "v", "d"],
        "commands": ["editor.action.showHover"]
    },
    {
        "before": ["<leader>", "enter"],
        "commands": ["editor.action.quickFix"]
    },
    {
        "before": ["K"],
        "commands": ["editor.action.showHover"]
    },
    {
        "before": ["<leader>", "s", "f"],
        "commands": ["workbench.action.quickOpen"]
    },
    {
        "before": ["<leader>", "g", "f"],
        "commands": ["workbench.action.findInFiles"]
    },
    {
        "before": [ "<leader>", "2"],
        "commands": [ "editor.action.marker.next"]
    },
    {
        "before": ["<leader>", "p", "v"],
        "commands": ["workbench.files.action.focusFilesExplorer"]
    },
    {
        "before": ["<leader>", "r", "r"],
        "commands": ["cmake.launchTarget"]
    },
    {
        "before": ["<leader>", "r", "d"],
        "commands": ["cmake.debugTarget"]
    },
    {
        "before": ["<leader>", "r", "t"],
        "commands": ["cmake.ctest"]
    },
    {
        "before": ["<leader>", "v", "t"],
        "commands": ["workbench.view.testing.focus"]
    }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
    {
        "before": ["<leader>", "y"],
        "commands": [ "editor.action.clipboardCopyAction" ]
    }
],
